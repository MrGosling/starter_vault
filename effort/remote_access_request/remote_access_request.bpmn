<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_RemoteAccessRequest" name="Remote Access Request" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_1" name="Черновик" camunda:candidateGroups="All">
      <bpmn:documentation>Allow Edit: All. Allow Self Approval: да.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_2" name="На доработке" camunda:candidateGroups="All">
      <bpmn:documentation>Allow Edit: All. Allow Self Approval: да.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_3" name="Согласование руководителя" camunda:candidateGroups="Head of subdivision">
      <bpmn:documentation>Allow Edit: Administrator. Allow Self Approval: да.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_4" name="Отклонено руководителем">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_5" name="Согласование УИБ" camunda:candidateGroups="Officer of Information Security">
      <bpmn:documentation>Allow Edit: Administrator. Allow Self Approval: да.</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_6" name="Отклонено УИБ">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_7" name="Исполнение заявки" camunda:candidateGroups="Technical support">
      <bpmn:documentation>Allow Edit: Administrator. Allow Self Approval: да.</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_8" name="Отклонено техническим специалистом">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_9" name="Доступы предоставлены" camunda:candidateGroups="Technical support">
      <bpmn:documentation>Allow Edit: Administrator. Allow Self Approval: да.</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_10" name="Доступы отозваны">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_11">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_12">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_13">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Task_3" name="Отправить на рассмотрение">
      <bpmn:documentation>Condition (Frappe): (frappe.session.user == 'Administrator') \
| (doc.owner == frappe.session.user) \
| (doc.employee == frappe.db.get_value('Employee', {'user_id': frappe.session.user}, ['name'])) \
| (doc.employee in frappe.db.get_list('Employee', filters={'parent_employee': frappe.db.get_value('Employee', {'user_id': frappe.session.user}, ['name'])}, fields=['name'], pluck='name'))</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_2" targetRef="Task_3" name="Отправить на рассмотрение">
      <bpmn:documentation>Condition (Frappe): (frappe.session.user == 'Administrator') \
| (doc.owner == frappe.session.user) \
| (doc.employee == frappe.db.get_value('Employee', {'user_id': frappe.session.user}, ['name'])) \
| (doc.employee in frappe.db.get_list('Employee', filters={'parent_employee': frappe.db.get_value('Employee', {'user_id': frappe.session.user}, ['name'])}, fields=['name'], pluck='name'))</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_3" targetRef="Gateway_11" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_11" targetRef="Task_5" name="Одобрено">
      <bpmn:documentation>Condition (Frappe): (frappe.session.user == 'Administrator') \
| (doc.name in frappe.db.get_list('ToDo', {'reference_type': doc.doctype, 'allocated_to': frappe.session.user}, ['reference_name'], pluck='reference_name'))</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${action == 'Одобрено'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_11" targetRef="Task_2" name="На доработку">
      <bpmn:documentation>Condition (Frappe): (frappe.session.user == 'Administrator') \
| (doc.name in frappe.db.get_list('ToDo', {'reference_type': doc.doctype, 'allocated_to': frappe.session.user}, ['reference_name'], pluck='reference_name'))</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${action == 'На доработку'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_11" targetRef="EndEvent_4" name="Отклонено">
      <bpmn:documentation>Condition (Frappe): (frappe.session.user == 'Administrator') \
| (doc.name in frappe.db.get_list('ToDo', {'reference_type': doc.doctype, 'allocated_to': frappe.session.user}, ['reference_name'], pluck='reference_name'))</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${action == 'Отклонено'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_5" targetRef="Gateway_12" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_12" targetRef="Task_7" name="Одобрено">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${action == 'Одобрено'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_12" targetRef="Task_2" name="На доработку">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${action == 'На доработку'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_12" targetRef="EndEvent_6" name="Отклонено">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${action == 'Отклонено'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_7" targetRef="Gateway_13" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_13" targetRef="Task_9" name="Предоставить доступы">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${action == 'Предоставить доступы'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_13" targetRef="Task_2" name="На доработку">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${action == 'На доработку'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_13" targetRef="EndEvent_8" name="Отклонено">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${action == 'Отклонено'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_9" targetRef="EndEvent_10" name="Отозвать доступы" />
  </bpmn:process>
